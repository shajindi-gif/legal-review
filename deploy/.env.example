# legalai86.com.cn 部署环境变量（生产）
#
# 首次部署：deploy.sh 会自动生成 deploy/.env，覆盖以下默认值。
# 自定义：复制本文件为 .env，修改后 sudo bash deploy.sh。
#
# ⚠️ 任何 SECRET 类的值都不要提交到 git。.env 已加入 .gitignore。

# ============================================================
# 基础（deploy.sh 自动生成密码，不要手填）
# ============================================================
POSTGRES_PASSWORD=changeme_pg_password_16bytes_random
JWT_SECRET=changeme_64_hex_chars_random

# ============================================================
# 域名 / CORS
# ============================================================
DOMAIN=legalai86.com.cn
WWW_DOMAIN=www.legalai86.com.cn
CORS_ORIGINS=https://legalai86.com.cn,https://www.legalai86.com.cn

# ============================================================
# LLM（按需至少填一个；不填则 LLM_PROVIDER=mock 走本地兜底）
# ============================================================
LLM_PROVIDER=mock                 # mock | deepseek | qwen | dashscope
LLM_MODEL_TIER=balanced           # fast | balanced | deep
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=mock           # mock | openai | dashscope

# ============================================================
# JWT TTL（秒）
# ============================================================
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ============================================================
# Agent 硬约束
# ============================================================
MAX_ITERATION=5
MIN_CONFIDENCE=0.7

# ============================================================
# M16 多租户 + 支付 + 隐私
# ============================================================
# 隐私政策 / 用户协议 / Cookie 政策 生效日（YYYY-MM-DD），落地页底部展示
PRIVACY_POLICY_EFFECTIVE_DATE=2026-08-26
TERMS_OF_SERVICE_EFFECTIVE_DATE=2026-08-26
COOKIE_POLICY_EFFECTIVE_DATE=2026-08-26

# 主体信息（用于隐私政策 / 用户协议落款 + 微信支付商户申请）
LEGAL_ENTITY_NAME=北京某某科技有限公司
ICP_RECORD=京ICP备 0000000 号-1
ICP_SECURITY_RECORD=京公网安备 11010100000000 号
CONTACT_EMAIL=legal@legalai86.com.cn
CONTACT_PHONE=010-00000000
OFFICE_ADDRESS=北京市海淀区某某路 1 号

# 微信支付 JSAPI（M16.2 上线时填，没填则 /api/v1/payment/* 走 503 模式）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_NOTIFY_URL=https://legalai86.com.cn/api/v1/payment/wechat/notify
WECHAT_PAY_SANDBOX=true           # 上线前保持 true 走沙箱；正式开闸后改 false

# 套餐（与 app/core/constants.py 保持一致）
PLAN_FREE_QUOTA=10                # 免费版每月审查次数
PLAN_PRO_PRICE_CENTS=9900         # 专业版月价（分）
PLAN_PRO_QUOTA=200
PLAN_ENTERPRISE_PRICE_CENTS=49900 # 律所版月价（分）
PLAN_ENTERPRISE_QUOTA=2000

# ============================================================
# 监控（可选，不填则不开启）
# ============================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ============================================================
# 部署标识（CI/CD 用）
# ============================================================
GIT_SHA=
BUILD_TIME=
