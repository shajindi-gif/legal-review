# ============== 应用 ==============
APP_NAME="行政规范性文件智能合法性审查 Agent 系统"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=local  # local|ci|staging|prod

# ============== 数据库 ==============
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_pass@localhost:5432/legal_review
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============== Redis ==============
REDIS_URL=redis://localhost:6379/0

# ============== 文件沙箱 ==============
SANDBOX_ROOT=./_sandbox
SANDBOX_MAX_FILE_MB=50
SANDBOX_ALLOWED_EXTENSIONS=docx,pdf,png,jpg,jpeg,txt

# ============== LLM Gateway ==============
# Provider 切换：deepseek|qwen|mock（生产环境用 deepseek/qwen，测试用 mock）
LLM_PROVIDER=deepseek  # deepseek|qwen|mock
# 模型档位：strong（旗舰）| balanced（速度优先）| flash（轻量便宜）| reasoner（带推理链）
LLM_MODEL_TIER=strong  # strong|balanced|flash|reasoner

# ---- DeepSeek（V4 系列 Pro/Flash 双档，2026-07 上线；旧 deepseek-chat/reasoner 已停用熔断）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# strong=deepseek-v4-pro(旗舰 Pro) / balanced=deepseek-v4-flash / flash=deepseek-v4-flash / reasoner=deepseek-v4-pro
DEEPSEEK_MODEL_STRONG=deepseek-v4-pro
DEEPSEEK_MODEL_BALANCED=deepseek-v4-flash
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_REASONER=deepseek-v4-pro

# ---- Qwen（Qwen3.7-Max 旗舰 MoE，2026 年；Qwen-Plus/Turbo 中轻档，两三代以内）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# strong=qwen3.7-max(旗舰 Max) / balanced=qwen-plus / flash=qwen-turbo / reasoner=qwen3.7-max
QWEN_MODEL_STRONG=qwen3.7-max
QWEN_MODEL_BALANCED=qwen-plus
QWEN_MODEL_FLASH=qwen-turbo
QWEN_MODEL_REASONER=qwen3.7-max

# ---- LLM Gateway 控制 ----
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0  # 指数退避基数（秒）
LLM_RATE_LIMIT_RPM=60  # 每分钟最大请求数

# ---- Embedding ----
EMBEDDING_PROVIDER=mock  # mock|bge-m3-local|dashscope
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
DASHSCOPE_API_KEY=  # Embedding 用 DashScope API 时填（与 QWEN_API_KEY 可共用）

# ============== 鉴权（Sprint 后续） ==============
JWT_SECRET=change_me_in_production
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ============== Agent 硬约束 ==============
MAX_ITERATION=5
MIN_CONFIDENCE=0.7
MAX_HALLUCINATION_RATE=0.05

# ============== CORS ==============
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============== 支付（Sprint 8.2）==============
# 公网回调基址（必须是已 ICP 备案的 HTTPS 地址，不带尾斜杠）
PUBLIC_BASE_URL=https://legalai86.com.cn

# ---- 微信支付 V3（Native 扫码 / JSAPI 微信内 / H5 手机浏览器）----
# 来源：微信商户平台 → 账户中心 → API 安全
WXPAY_ENABLED=false
WXPAY_MCHID=                    # 商户号（10 位数字）
WXPAY_APPID=                    # 公众号 / 应用 AppID（Native 下单需要）
WXPAY_APPSECRET=                # 公众号 AppSecret（JSAPI 静默 OAuth 换 openid）
WXPAY_API_V3_KEY=               # APIv3 密钥（32 字符，回调解密 AES-256-GCM 用）
WXPAY_MCH_SERIAL_NO=            # 商户 API 证书序列号（40 位十六进制，请求签名用）
WXPAY_MCH_PRIVATE_KEY=          # 商户 API 私钥（apiclient_key.pem 全文 PEM，请求签名用）
WXPAY_PUBLIC_KEY=               # 微信支付公钥（验签回调，非商户 apiclient 证书）
WXPAY_PUBLIC_KEY_ID=            # 微信支付公钥 ID（PUB_KEY_ID_xxx，回调头 serial）
WXPAY_NOTIFY_PATH=/api/v1/billing/wechat/notify
WXPAY_OAUTH_REDIRECT_URL=       # JSAPI OAuth 回调地址（须在公众号网页授权域名下）

# ---- 支付宝（电脑网站 page.pay / 手机网站 wap.pay，RSA2）----
# 来源：支付宝开放平台 → 应用详情 → 开发设置（签约「电脑网站支付 + 手机网站支付」）
ALIPAY_ENABLED=false
ALIPAY_APP_ID=                  # 应用 APPID（16 位数字）
ALIPAY_PRIVATE_KEY=             # 应用私钥（RSA2，SHA256WithRSA，PEM 全文或纯 base64 体）
ALIPAY_PUBLIC_KEY=              # 支付宝公钥（用于验签，非应用公钥）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_PATH=/api/v1/billing/alipay/notify
ALIPAY_RETURN_URL=              # 支付完成同步回跳地址（page/wap 的 return_url，可留空）
